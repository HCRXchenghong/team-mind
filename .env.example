# Copy to .env and replace every local password and key before startup.
# .env is ignored by Git. Never commit a real secret.
MYSQL_ROOT_PASSWORD=replace-with-random-local-root-password
MYSQL_USER=teammind
MYSQL_PASSWORD=replace-with-random-local-app-password
MYSQL_DSN=teammind:replace-with-random-local-app-password@tcp(127.0.0.1:3307)/teammind?charset=utf8mb4&parseTime=true&loc=UTC
API_ADDR=127.0.0.1:8188
APP_ENV=development
TEAM_APPROVAL_REQUIRED=0
# Replace with the origins used by the new Web and optional native clients.
# The sample values below are historical local development defaults.
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost,https://localhost,capacitor://localhost
# Production requires 32 random bytes encoded as 64 hex characters. Generate with `openssl rand -hex 32`.
LOGIN_RATE_LIMIT_HMAC_KEY=
# Set only the exact reverse-proxy CIDRs that may supply X-Forwarded-For; empty means trust the socket peer only.
TRUSTED_PROXY_CIDRS=
# MFA TOTP secrets are AES-GCM encrypted in MySQL. Generate with `openssl rand -base64 32`.
# Keep this key in a secret manager and preserve it across restarts; losing it requires users to reset MFA.
MFA_ENCRYPTION_KEY=
# Personal agent workspace files are AES-GCM encrypted before storage in MySQL.
# Generate a 32-byte key with `openssl rand -base64 32`; keep it stable and in a secret manager.
AGENT_WORKSPACE_ENCRYPTION_KEY=
# Leave empty to use Vite's same-origin /api/v1 proxy.

# AI providers are configured by the platform super admin in the AI management
# page. This key encrypts their API keys at rest; generate with
# `openssl rand -base64 32` and keep it stable.
AI_CONFIG_ENCRYPTION_KEY=
# Signs public Gantt share links. Defaults to LOGIN_RATE_LIMIT_HMAC_KEY when
# empty; production should set a dedicated random secret.
GANTT_SHARE_SECRET=

# unconfigured or real. Real mode needs the pinned Tencent plugin Gateway
# below and a separately started wechat-worker. Test-only mock sessions are
# rejected outside APP_ENV=test and never create a real binding.
WECHAT_MODE=unconfigured
# 32 random bytes, base64 encoded. Generate: openssl rand -base64 32
WECHAT_ENCRYPTION_KEY=
# Go API and plugin bridge must share this 32-byte-or-longer random bearer key.
# The gateway binds only to loopback and the plugin route checks loopback again.
WECHAT_GATEWAY_URL=http://127.0.0.1:18793/teammind-wechat-bridge/v1
WECHAT_GATEWAY_PORT=18793
WECHAT_GATEWAY_BRIDGE_TOKEN=
# Optional private OpenClaw runtime state directory; defaults to a per-user
# directory under /dev/shm (gateway auth/config only, no channel token storage).
OPENCLAW_STATE_DIR=

# Only for the one-time bootstrap-admin command; do not leave these in
# long-lived production service environment variables.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=

# Password reset email for APP_ENV=production.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=

# 通知邮件仅在用户明确启用后投递；SMTP 465 使用隐式 TLS，其他端口必须支持 STARTTLS。
# 生产环境 PUBLIC_URL 应为用户实际访问的 HTTPS 地址。
# 浏览器推送需要 VAPID 私钥及订阅加密密钥；私钥可通过
# `cd backend && go run ./cmd/server generate-vapid-key` 生成。
# NOTIFICATION_ENCRYPTION_KEY 使用 `openssl rand -base64 32` 生成。
# 不要提交真实密钥；轮换通知加密密钥前须迁移并重新加密所有订阅。
VAPID_PRIVATE_KEY=
# 必须填写真实可联系的邮箱地址或 HTTPS 联系页面；示例、保留域名会被判定为未配置。
VAPID_SUBJECT=
NOTIFICATION_ENCRYPTION_KEY=
# 原生 App 推送使用 Firebase Cloud Messaging HTTP v1。服务账号 JSON 文件不提交仓库，
# 生产文件应由密钥设施挂载且权限仅服务账号可读（例如 0600）。
FCM_SERVICE_ACCOUNT_FILE=

# macOS 代码沙箱：Docker Desktop 已共享的主机目录（不要用 /var/folders）。
# 留空时默认 ~/Library/Caches/teammind-sandbox；镜像由 scripts/sandbox/build-image.sh 准备。
TEAMMIND_SANDBOX_DIR=

# 检索层。auto：配置了 SEARXNG_URL 时优先 SearXNG，否则用内置 360/Bing；
# searxng：失败即报错，不静默降级；native：只用内置抓取。
SEARCH_PROVIDER=auto
# 自建 SearXNG 地址，例如 http://127.0.0.1:8080
SEARXNG_URL=


# Memory semantic recall (optional). Requires Ollama and a local embedding model:
#   ollama pull nomic-embed-text
# Falls back to lexical recall when unavailable. Remote endpoints are blocked
# unless MEMORY_EMBEDDING_ALLOW_REMOTE=true (memory text leaves this server).
OLLAMA_BASE_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_MODEL=nomic-embed-text
# MEMORY_EMBEDDING_DISABLED=true
# MEMORY_EMBEDDING_ALLOW_REMOTE=false

# Internal SMTP with a self-signed certificate only. Prefer a valid CA cert.
# SMTP_TLS_INSECURE=true

# Optional web extraction. Install with scripts/install-web-extractor.sh.
# TRAFILATURA_PYTHON=/usr/bin/python3
# TRAFILATURA_PYTHONPATH=.run/py-deps
# TRAFILATURA_SCRIPT=scripts/web_extract.py
# Firecrawl is optional; without a key web_fetch falls back to native fetch.
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Inbound WeChat voice: OpenAI-compatible STT endpoint.
# A loopback endpoint may omit STT_API_KEY; a remote endpoint requires it.
# STT_PROVIDER=mimo   # MiMo uses /chat/completions + input_audio
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
# STT_LANGUAGE=zh
